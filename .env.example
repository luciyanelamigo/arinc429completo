# MySQL connection. Use a URL-encoded password if it contains special characters.
DATABASE_URL=mysql+pymysql://arinc_user:change_me@127.0.0.1:3306/arinc429
SECRET_KEY=replace_with_a_long_random_value

# Hardware transmission is OFF unless explicitly enabled.
HW_SERIAL_ENABLED=0
HW_SERIAL_PORT=/dev/ttyUSB0
HW_SERIAL_BAUDRATE=115200
# Enable only for a documented adapter that accepts raw 4-byte words over UART.
HW_SERIAL_RAW_WORDS=0
